// Copy this file to Secrets.xcconfig (same folder) and fill in your key.
// Secrets.xcconfig is gitignored and must never be committed.
//
// Get a free Football-Data.org key at https://www.football-data.org/client/register
// Get an API-Football key at https://www.api-football.com/

FOOTBALL_DATA_KEY = your_football_data_org_key_here

// Optional: force a specific data source instead of AUTO.
// AUTO = live API when a key is present, otherwise mock data. MOCK = always mock. LIVE = always live.
// DATA_SOURCE_MODE = AUTO
